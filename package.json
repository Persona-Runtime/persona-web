{
  "name": "persona-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "container:verify": "bash scripts/verify-container.sh",
    "test:scripts": "bash scripts/check-image-listing.sh --self-test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.5.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.25.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "globals": "16.0.0",
    "jsdom": "26.0.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.30.1",
    "vitest": "^4.1.11"
  }
}
